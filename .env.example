# Copie este arquivo para .env e preencha. O .env nunca deve ir para o git.

# LLM do agente. Por padrão, DeepSeek: crie a chave em https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Modelos que aparecem no seletor da interface (o primeiro é o padrão)
LLM_MODELOS=deepseek-flash,deepseek-v4-pro
# Funciona com qualquer API compatível com a da OpenAI: troque LLM_BASE_URL e LLM_MODELOS.

# Chave PÚBLICA da API do DataJud, divulgada pelo CNJ.
# Ela pode mudar: a vigente fica em https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Porta no seu computador (Docker). Troque se a 8000 já estiver em uso.
API_PORT=8000

# Limite de uso do chat, para proteger a chave do LLM quando o app fica público.
# 0 desliga o teto. Os contadores ficam em memória e zeram quando o servidor reinicia.
LIMITE_IP_HORA=20
LIMITE_IP_DIA=60
LIMITE_GLOBAL_DIA=150
# Use 1 só atrás de um proxy confiável (como no Hugging Face), para ler o IP real no X-Forwarded-For.
CONFIAR_PROXY=0
